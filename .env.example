# Core (local Redis/Qdrant defaults are fine)
QDRANT_URL=http://localhost:6333
DATA_DIR=./data
REDIS_ENABLED=true
LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Optional: Ownify provisioning
# OWNIFY_PROVISIONING_API_KEY=

# Optional MCP connectors (leave disabled if unused)
GOOGLE_MCP_ENABLED=false
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=

SLACK_MCP_ENABLED=false
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_OAUTH_REDIRECT_URI=

NOTION_MCP_ENABLED=false
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_OAUTH_REDIRECT_URI=

MICROSOFT_MCP_ENABLED=false
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_REDIRECT_URI=
# MICROSOFT_OAUTH_TENANT_ID=
